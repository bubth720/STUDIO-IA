# syntax=docker/dockerfile:1
FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

RUN --mount=type=secret,id=proxy_ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca update && \
    apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca install -y --no-install-recommends \
      ffmpeg binutils git libegl1 libgl1 libxcb-cursor0 libxkbcommon-x11-0 \
      libdbus-1-3 libfontconfig1 fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --uid 1000 --create-home studio && mkdir /app && chown studio:studio /app
WORKDIR /app
COPY --chown=studio:studio . .
USER studio
ENV STUDIO_IA_HOME=/app/artifacts/state XDG_CACHE_HOME=/app/artifacts/cache \
    QT_QPA_PLATFORM=offscreen PYINSTALLER_CONFIG_DIR=/app/artifacts/pyinstaller-cache
RUN --mount=type=secret,id=proxy_ca,required=true,uid=1000,gid=1000,mode=0444 \
    python -m venv .venv && \
    PIP_CERT=/run/secrets/proxy_ca .venv/bin/python -m pip install pip==26.3 && \
    PIP_CERT=/run/secrets/proxy_ca .venv/bin/python -m pip install -e ".[gui,dev,build]"
CMD [".venv/bin/python", "scripts/qualify_current.py"]

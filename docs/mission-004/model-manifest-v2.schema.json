{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STUDIO IA M004 — future qualified local model manifest (not implemented by V1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "family", "technique", "engine", "model_version", "licenses", "files", "qualification"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]+$"},
    "family": {"enum": ["real_esrgan", "anime4k", "rife"]},
    "technique": {"enum": ["neural_super_resolution", "neural_cnn", "classic_shader", "neural_interpolation"]},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "binary_sha256", "source_url", "source_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "source_url": {"type": "string", "pattern": "^https://"},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "model_version": {"type": "string", "minLength": 1},
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_spdx", "weights_or_shaders_terms", "redistribution_review"],
      "properties": {
        "code_spdx": {"type": "string", "minLength": 1},
        "weights_or_shaders_terms": {"type": "string", "minLength": 1},
        "redistribution_review": {"enum": ["external_only", "approved_with_notices", "not_approved"]}
      }
    },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["local_path", "size_bytes", "expected_sha256", "actual_sha256", "origin_url"],
        "properties": {
          "local_path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "expected_sha256": {"$ref": "#/$defs/sha256"},
          "actual_sha256": {"$ref": "#/$defs/sha256"},
          "origin_url": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "native_scales": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 8}},
    "hardware_requirements": {
      "type": "object",
      "properties": {
        "api": {"type": ["string", "null"]},
        "minimum_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "requirements_source": {"type": ["string", "null"]}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "tested_at_utc", "hardware_observed", "proof_path"],
      "properties": {
        "state": {"enum": ["integrity_verified", "compatible", "short_test_passed", "video_validated"]},
        "tested_at_utc": {"type": ["string", "null"]},
        "hardware_observed": {"type": ["object", "null"]},
        "proof_path": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "$comment": "Design artifact only. Runtime must check hash equality, trusted origins, local path safety, real inference evidence and version-specific command compatibility. Schema validation alone never establishes those facts."
}
